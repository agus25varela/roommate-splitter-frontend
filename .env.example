# Copia este archivo a .env.local y completá los valores
# (no se commitean credenciales en el repo)

# Backend de Roommate Splitter
VITE_API_URL=http://localhost:8080/api

# Repo de GitHub que alimenta el dashboard de proyecto (obligatorio)
VITE_GITHUB_REPO_OWNER=
VITE_GITHUB_REPO_NAME=

# Token de GitHub (opcional). Sin token: modo público + datos de demo.
VITE_GITHUB_TOKEN=